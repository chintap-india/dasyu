{
  "name": "dasyu",
  "version": "0.1.1",
  "description": "Deep web snapshot, full-page screenshot, and markdown content extraction utility powered by Playwright.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "dasyu": "./bin/dasyu.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bump:patch": "npm version patch && git push --follow-tags",
    "bump:minor": "npm version minor && git push --follow-tags",
    "bump:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "playwright",
    "crawler",
    "screenshot",
    "scraper",
    "markdown",
    "dasyu",
    "astra",
    "automation",
    "web-snapshot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "commander": "^12.1.0",
    "jsdom": "^25.0.0",
    "picocolors": "^1.1.0",
    "playwright": "^1.45.0",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.10",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
